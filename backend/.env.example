# ─── Server ───────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── MongoDB ──────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/wishdora
# For Atlas: mongodb+srv://<user>:<pass>@cluster.mongodb.net/wishdora

# ─── JWT ──────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# External scheduler authentication (use a long random value in production)
CRON_SECRET=replace_with_a_long_random_secret

# ─── Gmail SMTP ───────────────────────────────────────────
GMAIL_USER=your_gmail@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password
# Generate App Password: Google Account → Security → 2FA → App Passwords

# ─── WhatsApp Business (Meta Cloud API) ───────────────────
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_meta_access_token
WHATSAPP_FROM_NUMBER=+94XXXXXXXXX
# Get from: developers.facebook.com → WhatsApp → Getting Started

# ─── Frontend URL ─────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
